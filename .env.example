APP_NAME="Grupo QuarenteNA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_TIMEZONE=America/Bahia
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

APP_HTTP_PORT=8088
COMPOSE_PROJECT_NAME=quarentena

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=quarentena_dev
DB_USERNAME=quarentena
DB_PASSWORD=
DB_TEST_DATABASE=quarentena_test
DB_TEST_USERNAME=quarentena_test
DB_TEST_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Proxies concretos confiáveis (CIDR ou IP) separados por vírgula, se necessário.
TRUSTED_PROXIES=

# Para stack Swarm: imagem imutável, secrets externos e rede de Tunnel previamente provisionada.
QUARENTENA_IMAGE=ghcr.io/grupoquarentena/site:dev
