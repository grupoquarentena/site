# Grupo QuarenteNA — ambiente local (WSL / Docker Compose)
# Copie para .env, preencha os valores locais e NÃO versione o arquivo real.
# Use quebras de linha LF; APP_KEY é gerada em --preparar.

# Nome exibido, ambiente Laravel (local/testing/production) e depuração (false na produção).
APP_NAME="Grupo QuarenteNA"
APP_ENV=local
APP_DEBUG=true
# Chave criptográfica da aplicação; mantenha vazia até a primeira preparação.
APP_KEY=
# Chaves antigas separadas por vírgula, apenas durante rotação autorizada.
APP_PREVIOUS_KEYS=
# URL absoluta da aplicação (mudar para HTTPS no ambiente público).
APP_URL=http://localhost:8088
# Timezone e localidade do projeto.
APP_TIMEZONE=America/Bahia
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

# Porta HTTP publicada apenas no loopback; identificador isolado do projeto no Compose.
APP_HTTP_PORT=8088
COMPOSE_PROJECT_NAME=quarentena

# Logs: stderr é adequado a containers; debug apenas em desenvolvimento.
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# PostgreSQL principal no serviço Docker interno (não publicar a porta 5432 no host).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=quarentena_dev
DB_USERNAME=quarentena
# Preencha com senha forte local, sem reutilizar credenciais de produção.
DB_PASSWORD=
# Deixe vazio: se definido, DB_URL pode substituir os parâmetros acima.
DB_URL=

# Banco efêmero postgres_test para a suíte de integração; credenciais distintas.
DB_TEST_DATABASE=quarentena_test
DB_TEST_USERNAME=quarentena_test
DB_TEST_PASSWORD=

# Sessões/cache/fila na base PostgreSQL (tabelas criadas por migrations).
SESSION_DRIVER=database
# Tempo em minutos até a expiração por inatividade.
SESSION_LIFETIME=120
# Cookie Secure: false para HTTP local; true em HTTPS/produção.
SESSION_SECURE_COOKIE=false
# Domínio de cookie vazio usa o host atual (recomendado para desenvolvimento).
SESSION_DOMAIN=
CACHE_STORE=database
QUEUE_CONNECTION=database

# Hosts HTTP permitidos (nomes exatos separados por vírgula, sem porta/esquema).
# Produção: substitua por GrupoQuarenteNA.org e outros hosts públicos aprovados.
TRUSTED_HOSTS=localhost,127.0.0.1
# IPs/CIDRs dos proxies reversos efetivamente confiáveis. Vazio no desenvolvimento.
# Nunca usar '*' por conveniência; validar a topologia de Cloudflare Tunnel/Swarm.
TRUSTED_PROXIES=

# Imagem imutável usada no Swarm, por tag SHA ou digest após homologação.
# Exemplo: ghcr.io/grupoquarentena/site:sha-<commit>; build não significa deploy.
QUARENTENA_IMAGE=
